From: n2n-fuzzing <fuzzer@localhost>
Date: Mon, 01 Jan 2025 00:00:00 +0000
Subject: [PATCH 1/3] fuzzing: make supernode deterministic for AFL

Fix non-deterministic behaviour that causes AFL to generate too many
"uninteresting" paths:
  - seed PRNG with a fixed value when AFL_FUZZING is defined
  - replace gettimeofday() with a stub that returns a fixed timestamp
  - disable UDP socket SO_REUSEADDR retry loop (causes hangs in AFL)

--- a/src/supernode.c
+++ b/src/supernode.c
@@ -1,6 +1,14 @@
+#ifdef AFL_FUZZING
+/* Deterministic timestamp for AFL: always return the same value */
+#include <sys/time.h>
+static int gettimeofday_orig(struct timeval *tv, struct timezone *tz) {
+    if (tv) { tv->tv_sec = 1700000000; tv->tv_usec = 0; }
+    return 0;
+}
+#define gettimeofday(tv, tz) gettimeofday_orig(tv, tz)
+#endif
+
 #include "n2n.h"
 #include "sn_utils.h"
 
@@ -45,6 +53,12 @@ int main(int argc, char *argv[]) {
     n2n_sn_t sss;
     int rc;
 
+#ifdef AFL_FUZZING
+    /* Fix PRNG seed for deterministic fuzzing */
+    srand(0x41464c4e);   /* "AFLN" */
+    srandom(0x41464c4e);
+#endif
+
     setlogmask(LOG_UPTO(LOG_DEBUG));
     openlog("supernode", LOG_CONS | LOG_NDELAY | LOG_PERROR | LOG_PID,
             LOG_DAEMON);
--- a/src/sn_utils.c
+++ b/src/sn_utils.c
@@ -10,6 +10,17 @@
 #include "sn_utils.h"
 #include "n2n_wire.h"
 
+#ifdef AFL_FUZZING
+/*
+ * Disable random community challenge generation — use a fixed value.
+ * Without this, every REGISTER_SUPER response differs, making AFL think
+ * each execution is a new path.
+ */
+static uint32_t afl_fixed_challenge = 0xDEADBEEF;
+#define n2n_rand() (afl_fixed_challenge)
+#endif
+
 /* *********************************************** */
 
 static sn_community_t *find_community(n2n_sn_t *sss, char *community_name) {
